<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.renato.financas</groupId>
  <artifactId>financas-email-api</artifactId>
  <version>1.0.0</version>
  <name>financas-email-api</name>
  <description>API responsável pelo envio de e-mails do sistema Finanças (confirmação de cadastro e notificação de login)</description>

<properties>
    <maven.compiler.release>21</maven.compiler.release>
 </properties> 

  <dependencies>
    <!-- REST controllers -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Envio de e-mail (JavaMailSender) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Validação de campos (@NotBlank, @Email) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistência com JPA/Hibernate (tabela de usuários no MySQL) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Driver JDBC do MySQL -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Argon2id para hash de senha (vencedor da Password Hashing Competition,
      considerado o padrão mais forte atualmente — memory-hard, resistente
      a ataques com GPU/ASIC). Precisa de biblioteca nativa do Argon2; esta
      versão do artefato já inclui os binários pré-compilados para Linux/
      macOS/Windows x86-64, sem precisar instalar nada à parte no sistema.
    -->
    <dependency>
      <groupId>de.mkammerer</groupId>
      <artifactId>argon2-jvm</artifactId>
      <version>2.12</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Força o Maven a compilar com JDK 21, independente de qual JDK
        está rodando o Maven no momento (evita o bug do maven-compiler-plugin
        ao rodar em cima do JDK 25). Requer um toolchains.xml configurado
        em ~/.m2/toolchains.xml apontando pro JDK 21 instalado na máquina.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <goals>
              <goal>toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <toolchains>
            <jdk>
              <version>21</version>
            </jdk>
          </toolchains>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
